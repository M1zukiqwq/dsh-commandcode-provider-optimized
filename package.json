{
  "name": "@m1zukiqwq/dsh-commandcode-provider-optimized",
  "version": "0.2.0",
  "description": "Optimized Command Code provider for dsh: client-view catalog (plan, efforts, modalities), Go + GOAT plans, live refresh",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "release": "npm run build && npm version patch && git push --follow-tags"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "commandcode",
    "commandcode-go",
    "commandcode-goat",
    "llm-provider",
    "dsh-bundle",
    "optimized"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M1zukiqwq/dsh-commandcode-provider-optimized.git"
  },
  "homepage": "https://github.com/M1zukiqwq/dsh-commandcode-provider-optimized#readme",
  "bugs": {
    "url": "https://github.com/M1zukiqwq/dsh-commandcode-provider-optimized/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      },
      "profiles": [
        "web",
        "headless",
        "desktop"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-timeout": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-util-values": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
